{
  "name": "bank-reminder",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e-mobile --project=e2e-desktop",
    "test:e2e:prod": "node scripts/e2e-prod.mjs",
    "test:e2e:authed": "playwright test --project=authed --workers=1",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test:a11y": "playwright test --project=a11y",
    "test:all": "npm run typecheck && npm run lint && npm run i18n:check && npm test && npm run test:e2e && npm run test:a11y && npm run test:e2e:authed && npm run test:e2e:prod",
    "db:setup": "npm --prefix scripts install --no-audit --no-fund",
    "db:assert": "node scripts/db.mjs assert",
    "db:push": "node scripts/db.mjs push",
    "db:types": "node scripts/db.mjs types",
    "db:test": "node scripts/db.mjs test",
    "db:sql": "node scripts/db.mjs sql",
    "email:build": "node scripts/build-email-templates.mjs",
    "db:deploy": "node scripts/db.mjs deploy",
    "db:secrets": "node scripts/setup-secrets.mjs",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "fn:test": "npx --yes deno@latest test -A --node-modules-dir=none supabase/functions/_shared/",
    "fn:check": "npx --yes deno@latest check --node-modules-dir=none supabase/functions/send-notifications/index.ts supabase/functions/send-test-push/index.ts supabase/functions/delete-account/index.ts supabase/functions/fx-refresh/index.ts supabase/functions/news-ingest/index.ts supabase/functions/list-aspsps/index.ts supabase/functions/bank-connect-start/index.ts supabase/functions/bank-connect-finish/index.ts supabase/functions/bank-disconnect/index.ts supabase/functions/bank-sync/index.ts",
    "e2e:user": "node scripts/e2e-user.mjs",
    "smtp:apply": "node scripts/apply-smtp.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
